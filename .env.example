# ------------------------------------------------------------
# Modèle du fichier de configuration
# ------------------------------------------------------------
# 1) Copier ce fichier en ".env"
# 2) Remplacer les valeurs par les vraies
# Le fichier .env n'est JAMAIS envoyé sur GitHub (il est dans le .gitignore)

# Clé secrète à fournir pour utiliser l'API
API_KEY=a-remplacer

# Adresse de connexion à la base PostgreSQL
DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@localhost:5432/projet5